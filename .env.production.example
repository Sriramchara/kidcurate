# ==========================================
# KidCurate Production Environment Variables
# ==========================================

# 1. Security & JWT (Generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-64-character-random-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 2. Managed PostgreSQL Database (e.g. Supabase, Neon, Railway Postgres, AWS RDS)
DATABASE_URL=postgresql+asyncpg://kidcurate:your_secure_password@your_db_host:5432/kidcurate_db

# 3. External API Credentials
YOUTUBE_API_KEY=your_production_youtube_data_api_v3_key
GEMINI_API_KEY=your_production_gemini_api_key

# 4. Domain & CORS Configuration
CORS_ORIGINS=["https://app.kidcurate.com","https://kidcurate.com"]
NEXT_PUBLIC_API_URL=https://api.kidcurate.com

# 5. App Runtime
APP_NAME=KidCurate
DEBUG=false

