# ==========================================
# KidCurate Production Environment Variables
# ==========================================

# 1. Security & JWT (Generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-64-character-random-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 2. Managed PostgreSQL Database (e.g. Render Postgres, Supabase, Neon, AWS RDS)
DATABASE_URL=postgresql+asyncpg://kidcurate:your_secure_password@your_db_host:5432/kidcurate_db

# 3. External API & OAuth Credentials
GOOGLE_CLIENT_ID=179684236627-d7j0s15cvkj6li430jku6easqma5q81l.apps.googleusercontent.com
YOUTUBE_API_KEY=your_production_youtube_data_api_v3_key

# 4. Gmail SMTP Configuration (for 6-digit OTP verification & Welcome Note emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kidcurateservices@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=kidcurateservices@gmail.com

# 5. Domain & CORS Configuration
CORS_ORIGINS=["https://app.kidcurate.com","https://kidcurate.com"]
NEXT_PUBLIC_API_URL=https://api.kidcurate.com

# 6. App Runtime
APP_NAME=KidCurate
ENVIRONMENT=production
DEBUG=false
