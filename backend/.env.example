# KidCurate Backend — Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://kidcurate:password@localhost:5432/kidcurate_db

# JWT
SECRET_KEY=replace-with-a-64-character-random-hex-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# External APIs & OAuth
GOOGLE_CLIENT_ID=179684236627-d7j0s15cvkj6li430jku6easqma5q81l.apps.googleusercontent.com
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Gmail SMTP (for 6-digit OTP verification & Welcome Note emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kidcurateservices@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=kidcurateservices@gmail.com

# App
APP_NAME=KidCurate
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
