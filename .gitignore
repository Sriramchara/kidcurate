# KidCurate — Master .gitignore

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Python Testing & Temporary DBs
.pytest_cache/
.coverage
.coverage.*
htmlcov/
tests/test_*.db
test_*.db
*.db
*.db-wal
*.db-shm

# Node & Next.js Web Portal
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Android & Gradle
.gradle/
.kotlin/
build/
android/build/
android/app/build/
android/local.properties
captures/
.externalNativeBuild/
.cxx/

# Android Keystores & Credentials (safety)
*.jks
*.keystore

# IDEs & Editors
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Environment variables & Local secrets
.env
.env.local
.env.*.local
!.env.example
!.env.production.example
